{
  "name": "mdre-vscode",
  "displayName": "MDRE",
  "description": "%description%",
  "version": "0.2.6",
  "publisher": "LaizhuangJi0601",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onCustomEditor:mdre.editor"
  ],
  "contributes": {
    "configuration": {
      "title": "MDRE",
      "properties": {
        "mdre.pdf.browserPath": {
          "type": "string",
          "default": "",
          "description": "%config.pdfBrowser%"
        }
      }
    },
    "commands": [
      {
        "command": "mdre.open",
        "title": "%command.open%"
      },
      {
        "command": "mdre.new",
        "title": "%command.new%"
      },
      {
        "command": "mdre.reloadEditor",
        "title": "%command.reload%"
      }
    ],
    "customEditors": [
      {
        "viewType": "mdre.editor",
        "displayName": "%editor.name%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "command": "mdre.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == mdre.editor"
      },
      {
        "command": "mdre.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == mdre.editor"
      },
      {
        "command": "mdre.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == mdre.editor"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mdre.open",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "pnpm check && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev": "node scripts/develop.mjs",
    "test": "pnpm test:ui && pnpm test:pdf && pnpm test:host",
    "test:ui": "node tests/webview.mjs",
    "test:host": "node tests/host.mjs",
    "test:watch": "node tests/watch.mjs",
    "test:math": "node tests/iframe-math.mjs",
    "test:code-core": "tsx --test tests/code-paragraph.test.ts",
    "test:code-ui": "node tests/code-block-ui.mjs",
    "test:insert-core": "tsx --test tests/insert-blocks.test.ts",
    "test:insert-ui": "node tests/insert-blocks-ui.mjs",
    "test:pdf": "node tests/pdf-export.mjs",
    "test:pdf-style": "node tests/pdf-list-inline.mjs",
    "package": "vsce package --no-dependencies --no-rewrite-relative-links",
    "vscode:prepublish": "pnpm build",
    "test:core": "tsx --test tests/*.test.ts",
    "licenses": "node scripts/generate-licenses.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.5",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.10.1",
    "entities": "^6.0.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "markdown-it": "^14.1.0",
    "mathlive": "0.111.1",
    "mermaid": "^11.12.1",
    "playwright-core": "1.64.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-transform": "^1.10.5",
    "prosemirror-view": "^1.41.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "icon": "media/icon.png",
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "A4",
    "MDRE"
  ],
  "pricing": "Free",
  "packageManager": "pnpm@12.11.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/LaizhuangJi0601/MDRE-for-VS-Code.git"
  },
  "bugs": {
    "url": "https://github.com/LaizhuangJi0601/MDRE-for-VS-Code/issues"
  },
  "homepage": "https://github.com/LaizhuangJi0601/MDRE-for-VS-Code#readme"
}
